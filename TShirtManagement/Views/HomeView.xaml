<UserControl x:Class="TShirtManagement.Views.HomeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F0F4F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- PAGE TITLE -->
        <Border Grid.Row="0" Padding="28 24 28 0">
            <StackPanel>
                <TextBlock Text="T-Shirt Records" FontSize="22"
                           FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="View, search and manage all T-shirt entries"
                           FontSize="12" Foreground="#94A3B8" Margin="0 4 0 0"/>
            </StackPanel>
        </Border>

        <!-- TOOLBAR -->
        <Border Grid.Row="1" Padding="28 16 28 0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Grid Margin="0 0 8 0">
                        <TextBox Width="280"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="🔍  Search by brand, type or design..."
                                   Foreground="#CBD5E1" FontSize="12"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center" Margin="12 0 0 0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Content="Search" Width="90" Height="36"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SearchCommand}"/>
                </StackPanel>

                <!-- Right buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="↻  Refresh" Width="100" Height="36"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshCommand}"
                            Margin="0 0 8 0"/>
                    <Button Content="➕  Add T-Shirt" Width="130" Height="36"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding OpenAddCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- STATS -->
        <Border Grid.Row="2" Margin="28 14 28 0">
            <StackPanel Orientation="Horizontal">
                <Border CornerRadius="12" Padding="20 14"
                        Background="#FFFFFF"
                        BorderThickness="1" BorderBrush="#E2E8F0"
                        Margin="0 0 12 0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="8"
                                          ShadowDepth="1" Opacity="0.05"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10"
                                Background="#DBEAFE" Margin="0 0 12 0">
                            <TextBlock Text="👕" FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Records.Count}"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="#1E293B"/>
                            <TextBlock Text="Total Records"
                                       FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- TABLE -->
        <Border Grid.Row="3" Margin="28 14 28 0" CornerRadius="12"
                Background="#FFFFFF" BorderBrush="#E2E8F0"
                BorderThickness="1" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="10"
                                  ShadowDepth="1" Opacity="0.05"/>
            </Border.Effect>
            <DataGrid ItemsSource="{Binding Records}"
                      SelectedItem="{Binding SelectedRecord}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      CanUserAddRows="False"
                      Style="{StaticResource ModernDataGrid}"
                      SelectionChanged="DataGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#"
                                        Binding="{Binding Id}"
                                        IsReadOnly="True" Width="55"/>
                    <DataGridTextColumn Header="BRAND"
                                        Binding="{Binding Brand}" Width="*"/>
                    <DataGridTextColumn Header="TYPE"
                                        Binding="{Binding Type}" Width="*"/>
                    <DataGridTextColumn Header="DESIGN"
                                        Binding="{Binding Design}" Width="180"/>
                    <DataGridTextColumn Header="PRICE"
                                        Binding="{Binding Price, StringFormat={}{0:N2}}"
                                        Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ACTION ROW -->
        <Border Grid.Row="4" Padding="28 14 28 20" Background="#F0F4F8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Selected: " FontSize="12"
                               Foreground="#94A3B8" VerticalAlignment="Center"/>
                    <TextBlock FontSize="12" FontWeight="SemiBold"
                               Foreground="#2563EB" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <Binding Path="SelectedRecord.Brand" FallbackValue="None"/>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="✏  Update" Width="130" Height="36"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding UpdateCommand}"
                            Margin="0 0 8 0"/>
                    <Button Content="🗑  Delete" Width="130" Height="36"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding DeleteCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
