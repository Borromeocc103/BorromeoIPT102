<UserControl x:Class="TShirtManagement.Views.AddTShirtView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F0F4F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- PAGE TITLE -->
        <Border Grid.Row="0" Padding="28 24 28 0">
            <StackPanel>
                <TextBlock Text="Add New T-Shirt" FontSize="22"
                           FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="Fill in the details to register a new entry"
                           FontSize="12" Foreground="#94A3B8" Margin="0 4 0 0"/>
            </StackPanel>
        </Border>

        <!-- FORM CARD -->
        <Border Grid.Row="1" Margin="28 16 28 28" CornerRadius="16"
                Background="#FFFFFF" BorderThickness="1" BorderBrush="#E2E8F0"
                Padding="36 32">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16"
                                  ShadowDepth="2" Opacity="0.06"/>
            </Border.Effect>

            <StackPanel MaxWidth="580" HorizontalAlignment="Left">

                <!-- Section header -->
                <StackPanel Orientation="Horizontal" Margin="0 0 0 24">
                    <Border Width="4" CornerRadius="2" Background="#2563EB" Margin="0 0 12 0"/>
                    <TextBlock Text="CUSTOMER INFORMATION" FontSize="11"
                               FontWeight="Bold" Foreground="#64748B"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Brand + Type row -->
                <Grid Margin="0 0 0 16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="BRAND" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="TYPE" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding Type, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- Design + Price row -->
                <Grid Margin="0 0 0 32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="DESIGN" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding Design, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PRICE (₱)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- Divider -->
                <Border Height="1" Background="#F1F5F9" Margin="0 0 0 24"/>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal">
                    <Button Content="💾  Save Record" Width="150" Height="40"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}"
                            Margin="0 0 10 0"/>
                    <Button Content="← Cancel" Width="110" Height="40"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding BackCommand}"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
