<Window x:Class="TShirtManagement.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TShirtManagement.ViewModels"
        Title="Borromeo T-Shirt System"
        Height="680" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8"
        BorderThickness="0"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0" Background="#1E3A5F">
            <DockPanel>

                <!-- Logo -->
                <Border DockPanel.Dock="Top" Padding="0 36 0 28"
                        BorderThickness="0 0 0 1" BorderBrush="#2563EB">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="16"
                                HorizontalAlignment="Center" Background="#2563EB">
                            <TextBlock Text="👕" FontSize="28"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="BORROMEO" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" Foreground="#FFFFFF"
                                   Margin="0 12 0 0"/>
                        <TextBlock Text="T-Shirt System" FontSize="10"
                                   HorizontalAlignment="Center"
                                   Foreground="#93C5FD" Margin="0 3 0 0"/>
                    </StackPanel>
                </Border>

                <!-- Nav label -->
                <TextBlock DockPanel.Dock="Top" Text="MENU"
                           FontSize="9" FontWeight="Bold"
                           Foreground="#475569" Margin="20 20 0 8"/>

                <!-- Nav buttons -->
                <StackPanel DockPanel.Dock="Top" Margin="12 0">
                    <Button Content="  🏠  Dashboard"
                            Height="44" Margin="0 2"
                            HorizontalContentAlignment="Left"
                            Padding="14 0"
                            Command="{Binding OpenHomeCommand}"
                            Style="{StaticResource SidebarButton}"/>
                    <Button Content="  ➕  Add T-Shirt"
                            Height="44" Margin="0 2"
                            HorizontalContentAlignment="Left"
                            Padding="14 0"
                            Command="{Binding OpenAddCommand}"
                            Style="{StaticResource SidebarButton}"/>
                </StackPanel>

                <!-- Footer -->
                <Border DockPanel.Dock="Bottom" Padding="20 14"
                        BorderThickness="0 1 0 0" BorderBrush="#1D4ED8">
                    <TextBlock Text="© 2025 Borromeo IPT102"
                               FontSize="10" Foreground="#475569"
                               HorizontalAlignment="Center"/>
                </Border>

            </DockPanel>
        </Border>

        <!-- ===== CONTENT ===== -->
        <Grid Grid.Column="1" Background="#F0F4F8">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Background="#FFFFFF" Padding="24 0"
                    BorderThickness="0 0 0 1" BorderBrush="#E2E8F0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="8"
                                      ShadowDepth="1" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="T-Shirt Management System"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
        </Grid>

    </Grid>
</Window>
