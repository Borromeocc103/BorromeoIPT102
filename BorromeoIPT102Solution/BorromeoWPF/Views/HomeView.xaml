<UserControl x:Class="BorromeoWPF.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Welcome to Borromeo" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <Button Content="Manage T-Shirts" Command="{Binding NavigateToTshirtCommand}"
                    Padding="20,10" FontSize="16" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
